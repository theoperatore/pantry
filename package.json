{
  "name": "pantry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:reseed": "supabase db reset",
    "db:start": "supabase start && npm run db:types",
    "db:types": "kysely-codegen --env-file .env.local --dialect postgres --url 'env(POSTGRES_URL)' --include-pattern='public.*' --out-file src/db/types.ts",
    "db:stop": "supabase stop"
  },
  "dependencies": {
    "@mantine/core": "^7.11.2",
    "@supabase/ssr": "^0.4.0",
    "@supabase/supabase-js": "^2.44.4",
    "@tabler/icons-react": "^3.11.0",
    "content-security-policy-builder": "^2.2.0",
    "date-fns": "^3.6.0",
    "kysely": "^0.27.4",
    "next": "14.2.5",
    "pg": "^8.12.0",
    "postgres-interval": "^4.0.2",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^20",
    "@types/pg": "^8.11.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "kysely-codegen": "^0.15.0",
    "postcss": "^8.4.40",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^9.6.0",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.3.3",
    "supabase": "^1.187.3",
    "typescript": "^5.5.4"
  }
}
